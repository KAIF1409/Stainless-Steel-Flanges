# URL of the Google Apps Script web app deployment that appends form
# submissions to a Google Sheet. See README.md "Enquiry form backend"
# for the Apps Script snippet and deployment steps.
SHEETS_WEBHOOK_URL=

# Google Tag Manager container ID (e.g. GTM-ABC1234). Leave unset to skip
# loading GTM entirely; the generate_lead dataLayer event still fires on
# successful form submission either way.
NEXT_PUBLIC_GTM_ID=
